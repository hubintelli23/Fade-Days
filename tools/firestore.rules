rules_version = '2';

// Fade & Days Firestore 보안 규칙
// 권한 표는 README의 "공유 앨범 권한"과 src/lib/permissions.ts 와 같다.
// 같이 보기: 같은 앨범 멤버끼리는 서로의 '같이 보기' 추억·시간 로그를 albums/{id}/feed 에서 읽는다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /* ---------- 개인 공간: 프로필 · 추억 · 로그 ---------- */

    match /users/{uid} {
      allow read, write: if isMe(uid);

      match /memories/{memoryId} {
        allow read, write: if isMe(uid);
      }
      match /logs/{logId} {
        allow read, write: if isMe(uid);
      }
      // 사진 데이터 (VITE_PHOTO_BACKEND=firestore)
      // 공유 앨범 멤버도 사진을 봐야 하므로 로그인한 사용자는 읽을 수 있다.
      // 사진 id는 추측할 수 없는 무작위 값이고, id는 앨범 멤버에게만 보이는 entries 안에만 있다.
      match /photos/{photoId} {
        allow get: if signedIn();
        allow create: if isMe(uid)
          && request.resource.data.ownerId == uid
          && request.resource.data.data is bytes
          && request.resource.data.data.size() < 1000000;
        allow delete: if isMe(uid);
      }
    }

    /* ---------- 앨범 ---------- */

    match /albums/{albumId} {
      function data() {
        return resource.data;
      }
      function isMember() {
        return signedIn() && request.auth.uid in data().memberIds;
      }
      function isOwner() {
        return signedIn() && data().ownerId == request.auth.uid;
      }

      allow read: if isMember();

      // 만들 때: 내가 소유자이고, 멤버는 나 하나
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == 'owner';

      allow delete: if isOwner();

      allow update: if isOwnerUpdate() || isJoining() || isLeaving() || isRenamingMyself();

      // 소유자: 이름·설명·멤버 역할·내보내기 (소유자 자체는 바꿀 수 없음)
      function isOwnerUpdate() {
        return isOwner()
          && request.resource.data.ownerId == data().ownerId
          && request.resource.data.members[data().ownerId].role == 'owner'
          && data().ownerId in request.resource.data.memberIds;
      }

      // 초대 코드로 참여: 나 자신만, 초대에 적힌 역할로
      function isJoining() {
        let uid = request.auth.uid;
        let invite = get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data;
        return signedIn()
          && !(uid in data().memberIds)
          && changed().hasOnly(['memberIds', 'members', 'joinCode'])
          && invite.albumId == albumId
          && invite.revoked == false
          && invite.expiresAt > request.time.toMillis()
          && (invite.maxUses == null || invite.useCount < invite.maxUses)
          && request.resource.data.memberIds.toSet() == data().memberIds.toSet().union([uid].toSet())
          && request.resource.data.members.diff(data().members).affectedKeys().hasOnly([uid])
          && request.resource.data.members[uid].role == invite.role;
      }

      // 스스로 나가기 (소유자는 나갈 수 없음)
      function isLeaving() {
        let uid = request.auth.uid;
        return isMember()
          && data().ownerId != uid
          && changed().hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds.toSet() == data().memberIds.toSet().difference([uid].toSet())
          && request.resource.data.members.diff(data().members).affectedKeys().hasOnly([uid])
          && !(uid in request.resource.data.members);
      }

      // 내 표시 이름 바꾸기 (역할은 그대로)
      function isRenamingMyself() {
        let uid = request.auth.uid;
        return isMember()
          && changed().hasOnly(['members'])
          && request.resource.data.members.diff(data().members).affectedKeys().hasOnly([uid])
          && request.resource.data.members[uid].role == data().members[uid].role
          && request.resource.data.members[uid].joinedAt == data().members[uid].joinedAt;
      }

      /* 하위 문서(entries, feed)에서 쓰는 도우미 */
      function album() {
        return get(/databases/$(database)/documents/albums/$(albumId)).data;
      }
      function inAlbum() {
        return signedIn() && request.auth.uid in album().memberIds;
      }
      function myRole() {
        return album().members[request.auth.uid].role;
      }

      /* 앨범에 넣은 추억의 사본 */
      match /entries/{memoryId} {
        allow read: if inAlbum();
        // 추가: 소유자·편집자가 자기 추억만
        allow create: if inAlbum()
          && myRole() in ['owner', 'editor']
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.addedBy == request.auth.uid;
        // 수정: 추억 작성자 본인만 (추억을 고치면 사본도 같이 고쳐짐)
        allow update: if inAlbum()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.addedBy == resource.data.addedBy;
        // 빼기: 작성자 본인 또는 앨범 소유자
        allow delete: if signedIn()
          && (resource.data.ownerId == request.auth.uid || myRole() == 'owner');
      }

      /* 같이 보기 사본: 멤버들의 '같이 보기' 추억·시간 로그.
         앨범 멤버는 모두 읽을 수 있고, 각자 자기 것만 쓴다. ('나만 보기'로 둔 것은 올라오지 않음) */
      match /feed/{itemId} {
        allow read: if inAlbum();
        allow create: if inAlbum()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.kind in ['memory', 'log'];
        allow update: if inAlbum()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid;
        // 본인, 또는 앨범 소유자(내보내기·앨범 삭제 때)
        allow delete: if signedIn()
          && (resource.data.ownerId == request.auth.uid || myRole() == 'owner');
      }
    }

    /* ---------- 초대 코드 ---------- */

    match /invites/{code} {
      function albumOf(albumId) {
        return get(/databases/$(database)/documents/albums/$(albumId)).data;
      }

      // 코드를 아는 사람은 미리보기 가능. 목록 조회는 내가 만든 것만.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && albumOf(request.resource.data.albumId).ownerId == request.auth.uid
        && request.resource.data.role in ['editor', 'viewer']
        && request.resource.data.useCount == 0
        && request.resource.data.revoked == false;

      allow update: if
        // 소유자: 취소, 앨범 이름 갱신
        (signedIn() && albumOf(resource.data.albumId).ownerId == request.auth.uid
          && changed().hasOnly(['revoked', 'albumTitle']))
        // 참여한 사람: 사용 횟수 +1 (같은 일괄 작업으로 앨범에 들어간 경우만)
        || (signedIn()
          && changed().hasOnly(['useCount'])
          && request.resource.data.useCount == resource.data.useCount + 1
          && request.auth.uid in getAfter(/databases/$(database)/documents/albums/$(resource.data.albumId)).data.memberIds);

      allow delete: if signedIn() && albumOf(resource.data.albumId).ownerId == request.auth.uid;
    }
  }
}
